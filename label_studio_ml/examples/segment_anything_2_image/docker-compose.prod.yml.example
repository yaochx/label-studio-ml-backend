version: "3.8"

# 生产环境配置示例
# 使用从 Docker Hub 拉取的预构建镜像，而不是本地构建
# 
# 使用方法:
# 1. 复制此文件: cp docker-compose.prod.yml.example docker-compose.prod.yml
# 2. 更新镜像名称为你构建的镜像
# 3. 运行: docker compose -f docker-compose.prod.yml up -d

services:
  ml-backend:
    container_name: ml-backend
    # 使用从 Docker Hub 拉取的镜像（替换为你的 Docker Hub 用户名和镜像名）
    image: your-dockerhub-username/label-studio-ml-sam2:latest
    
    # 生产环境不需要 build 配置，直接使用镜像
    # build:
    #   context: .
    #   dockerfile: Dockerfile
    #   target: production

    #    deploy:
    #      resources:
    #        reservations:
    #          devices:
    #            - driver: nvidia
    #              count: 1
    #              capabilities: [ gpu ]

    environment:
      # specify these parameters if you want to use basic auth for the model server
      - BASIC_AUTH_USER=hi-algo
      - BASIC_AUTH_PASS=hi-algo-2026
      # set the log level for the model server (WARNING for production, DEBUG for development)
      - LOG_LEVEL=WARNING
      # specify the number of workers and threads for the model server
      # WORKERS: recommended = CPU cores * 2 + 1
      - WORKERS=4
      - THREADS=8
      # specify the model directory (likely you don't need to change this)
      - MODEL_DIR=/data/models
      # specify device
      - DEVICE=cuda # or 'cpu' (coming soon)
      # SAM2 model config
      - MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_l.yaml
      # SAM2 checkpoint
      - MODEL_CHECKPOINT=sam2.1_hiera_large.pt

      # Specify the Label Studio URL and API key to access
      # uploaded, local storage and cloud storage files.
      # Do not use 'localhost' as it does not work within Docker containers.
      # Use prefix 'http://' or 'https://' for the URL always.
      # Determine the actual IP using 'ifconfig' (Linux/Mac) or 'ipconfig' (Windows).
      - LABEL_STUDIO_URL=http://192.168.3.99:8080
      - LABEL_STUDIO_API_KEY=775f2a958ffc9dbcf806d983a81a0c4857cbb4a0
    ports:
      - "9090:9090"
    volumes:
      - "./data/server:/data"
    restart: unless-stopped  # 生产环境建议添加自动重启
